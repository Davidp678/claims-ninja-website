{
  "name": "claims-ninja-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:chat-api": "node scripts/chat-api-smoke.mjs",
    "test:chat-knowledge": "npx tsx --test src/lib/chatbot/chat-knowledge-retrieval.test.ts",
    "test:chat-leads": "node scripts/chat-lead-api-smoke.mjs",
    "test:chat-lead-flow": "npx tsx --test src/components/chatbot/chat-lead-flow.test.ts",
    "test:chat:unit": "npm run test:chat-knowledge && npm run test:chat-lead-flow",
    "test:onboarding:unit": "npx tsx --test src/lib/onboarding/s2s.test.ts src/lib/onboarding/password-policy.test.ts src/lib/onboarding/agreement-canonical.test.ts src/lib/onboarding/staging-guard.test.ts src/lib/onboarding/upload-state.test.ts src/lib/legal/privacy-policy.test.ts",
    "validate:onboarding-staging": "node --env-file=.env.staging.local scripts/validate-onboarding-staging.mjs",
    "scan:client-bundle-secrets": "node scripts/scan-client-bundle-secrets.mjs",
    "visual:onboarding:staging": "playwright test --config=playwright.onboarding-visual.config.ts",
    "visual:onboarding:fixtures": "playwright test --config=playwright.onboarding-fixture-visual.config.ts",
    "audit:seo": "npx tsx scripts/seo-migration-audit.ts",
    "test:seo-redirects": "npx tsx scripts/seo-redirect-smoke.ts",
    "smoke:production": "playwright test --config=playwright.smoke.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "framer-motion": "^12.40.0",
    "next": "16.2.6",
    "openai": "^6.38.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
